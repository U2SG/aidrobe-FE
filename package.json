{
  "name": "aidrobe-frontend",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "web:clear": "expo start --web --clear",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "eas-build-post-install": "npx install-skia",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-node.cjs && node scripts/run-regressions.ts && node scripts/check-copy-denylist.ts",
    "preflight:phone": "node scripts/check-preview-backend.cjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.0",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-location": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.53.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.13",
    "zustand": "^4.5.5",
    "expo-system-ui": "~57.0.3",
    "@expo/dom-webview": "~57.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "@react-native/metro-config": "0.86.3"
  }
}
