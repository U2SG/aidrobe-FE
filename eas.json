{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "API_BASE_URL": "http://100.89.226.13:8000",
        "DEV_USER_ID": "00000000-0000-4000-8000-000000000001"
      }
    },
    "preview-v2": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "API_BASE_URL": "http://100.89.226.13:8000",
        "DEV_USER_ID": "00000000-0000-4000-8000-000000000001",
        "ENABLE_MVP_V2_UI": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production"
      }
    },
    "preview-v3": {
      "extends": "preview-v2",
      "distribution": "internal",
      "environment": "preview",
      "developmentClient": false,
      "node": "24.14.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AIDROBE_BUILD_VARIANT": "v3-preview",
        "ENABLE_V3_PURCHASE_DECISION": "true",
        "ENABLE_V3_AVATAR": "true",
        "ENABLE_V3_STATIC_TRYON": "true",
        "ENABLE_V3_ANALYTICS": "false"
      }
    }
  }
}
